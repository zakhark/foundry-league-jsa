# Copy this file to .env (which is not committed) and fill in the values.
# SHEET_ID is the long part of the league spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
# Optional: the API key blackbearsports.tv's own pages use (find it in your
# browser's dev tools, in the api_key=... of a request to /api/events).
# Used by "npm run blackbear" to link games to their Black Bear TV streams.
BLACKBEAR_API_KEY=
